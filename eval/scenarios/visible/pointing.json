  {"id": "pt_v03", "split": "visible", "dimension": "pointing", "category": "unlabeled-icon",
   "userPrompt": "Where's the source control tab?",
   "screens": ["vscode_main.jpg"],
   "expect": {"type": "point", "targets": [{"screen": 1, "element": "vscode_activity_source_control"}]}},

  {"id": "pt_v04", "split": "visible", "dimension": "pointing", "category": "panel-tab-or-status-item",
   "userPrompt": "How do I see all the errors in my project?",
   "screens": ["vscode_main.jpg"],
